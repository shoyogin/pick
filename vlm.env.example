# The vision-language model the VLM tab sends images to. Copy to vlm.env on each
# host — vlm.env is untracked, so the server address and key never reach the repo.
#
# Any OpenAI-compatible endpoint works (vLLM, TGI, Ollama, LM Studio, …): Pick
# POSTs to <VLM_BASE_URL>/chat/completions with the image as an image_url part.
# Leave VLM_BASE_URL empty to switch the tab off.

VLM_BASE_URL=http://vlm.example.internal:8000/v1
VLM_API_KEY=replace-me
VLM_MODEL=your-vision-model

# Optional. Seconds to wait for one answer, images checked at once, and the
# longest side (px) of the picture the model is sent.
VLM_TIMEOUT=120
VLM_WORKERS=2
VLM_MAX_SIDE=1280

# Reasoning models (Qwen3 and the like, on vLLM): off answers in a fraction of
# the time; on may judge better, but its thinking counts against VLM_MAX_TOKENS.
# Leave VLM_THINKING empty for servers that do not take the switch.
VLM_THINKING=off
VLM_MAX_TOKENS=1024
